function cleanSupabaseUrl(url) {
  if (!url) return "";
  let clean = url.trim();
  clean = clean.replace(/\/rest\/v1\/?$/i, '');
  clean = clean.replace(/\/+$/, '');
  return clean;
}

function withTimeout(promise, timeoutMs = 3500) {
  let timeoutHandle;
  const timeoutPromise = new Promise((_, reject) => {
    timeoutHandle = setTimeout(() => reject(new Error("Délai de réponse Supabase dépassé")), timeoutMs);
  });
  return Promise.race([
    promise.finally(() => clearTimeout(timeoutHandle)),
    timeoutPromise
  ]);
}

class SupabaseService {
  constructor() {
    this.client = null;
    this.url = "";
    this.anonKey = "";
    this.lastCloudError = null;
    this.init();
  }

  getCredentials() {
    const savedUrl = localStorage.getItem(SUPABASE_STORAGE_KEYS.url) || DEFAULT_SUPABASE_URL;
    const savedKey = localStorage.getItem(SUPABASE_STORAGE_KEYS.key) || DEFAULT_SUPABASE_ANON_KEY;
    return {
      url: cleanSupabaseUrl(savedUrl),
      anonKey: savedKey ? savedKey.trim() : ""
    };
  }

  init() {
    const creds = this.getCredentials();
    this.url = creds.url;
    this.anonKey = creds.anonKey;

    if (this.url && this.anonKey && window.supabase && window.supabase.createClient) {
      try {
        this.client = window.supabase.createClient(this.url, this.anonKey, {
          auth: { persistSession: false },
          global: { headers: { 'x-application-name': 'khadija_portfolio_admin' } }
        });
      } catch (err) {
        console.warn("Erreur initialisation Supabase :", err);
        this.client = null;
      }
    } else {
      this.client = null;
    }
  }

  isConfigured() {
    return Boolean(this.client && this.url && this.anonKey);
  }

  // --- Gestion du mot de passe Administrateur ---
  verifyPassword(enteredPassword) {
    const savedPassword = localStorage.getItem(SUPABASE_STORAGE_KEYS.password) || DEFAULT_ADMIN_PASSWORD;
    return enteredPassword === savedPassword;
  }

  changePassword(oldPassword, newPassword) {
    if (!this.verifyPassword(oldPassword)) {
      return { success: false, message: "Le mot de passe actuel est incorrect." };
    }
    if (!newPassword || newPassword.trim().length < 4) {
      return { success: false, message: "Le nouveau mot de passe doit comporter au moins 4 caractères." };
    }
    localStorage.setItem(SUPABASE_STORAGE_KEYS.password, newPassword.trim());
    return { success: true, message: "Clé d'accès modifiée avec succès ✦" };
  }

  // --- Sauvegarde & LocalStorage ---
  getLocal(key, fallback) {
    try {
      const raw = localStorage.getItem(key);
      if (!raw) return JSON.parse(JSON.stringify(fallback));
      const parsed = JSON.parse(raw);
      if (Array.isArray(fallback) && fallback.length > 0 && Array.isArray(parsed) && parsed.length === 0) {
        return JSON.parse(JSON.stringify(fallback));
      }
      return (parsed !== null && parsed !== undefined) ? parsed : fallback;
    } catch (e) {
      return JSON.parse(JSON.stringify(fallback));
    }
  }

  setLocal(key, data) {
    try {
      localStorage.setItem(key, JSON.stringify(data));
      return true;
    } catch (e) {
      console.warn("Stockage local saturé :", e);
      return false;
    }
  }

  saveCredentials(url, key) {
    const cleanUrl = cleanSupabaseUrl(url);
    if (cleanUrl) localStorage.setItem(SUPABASE_STORAGE_KEYS.url, cleanUrl);
    else localStorage.removeItem(SUPABASE_STORAGE_KEYS.url);

    if (key) localStorage.setItem(SUPABASE_STORAGE_KEYS.key, key.trim());
    else localStorage.removeItem(SUPABASE_STORAGE_KEYS.key);

    this.init();
  }

  // ==================================================================
  // DIAGNOSTIC COMPLET & TEST DE CONNEXION
  // ==================================================================
  async runFullDiagnostic(url, key) {
    const cleanUrl = cleanSupabaseUrl(url || this.url);
    const apiKey = (key || this.anonKey || "").trim();

    const report = {
      overallSuccess: false,
      clientOk: false,
      dbContentsOk: false,
      dbGalleryOk: false,
      dbCollabsOk: false,
      dbMessagesOk: false,
      dbSettingsOk: false,
      storageBucketOk: false,
      messages: []
    };

    if (!window.supabase || !window.supabase.createClient) {
      report.messages.push("❌ Librairie Supabase JS non disponible.");
      return report;
    }

    if (!cleanUrl || !apiKey) {
      report.messages.push("⚠️ URL de projet ou Clé API manquante.");
      return report;
    }

    let testClient;
    try {
      testClient = window.supabase.createClient(cleanUrl, apiKey);
      report.clientOk = true;
      report.messages.push("✅ Client Supabase initialisé.");
    } catch (e) {
      report.messages.push("❌ Erreur client : " + e.message);
      return report;
    }

    // 1. Table contents
    try {
      const { data, error } = await withTimeout(testClient.from('contents').select('id').limit(1), 3500);
      if (!error) {
        report.dbContentsOk = true;
        report.messages.push("✅ Table 'contents' (Vidéos & Reels) : Accessible");
      } else {
        report.messages.push("❌ Table 'contents' : " + error.message);
      }
    } catch (e) {
      report.messages.push("❌ Table 'contents' : " + e.message);
    }

    // 2. Table gallery
    try {
      const { data, error } = await withTimeout(testClient.from('gallery').select('id').limit(1), 3500);
      if (!error) {
        report.dbGalleryOk = true;
        report.messages.push("✅ Table 'gallery' (Univers & Photos) : Accessible");
      } else {
        report.messages.push("❌ Table 'gallery' : " + error.message);
      }
    } catch (e) {
      report.messages.push("❌ Table 'gallery' : " + e.message);
    }

    // 3. Table collabs
    try {
      const { data, error } = await withTimeout(testClient.from('collabs').select('id').limit(1), 3500);
      if (!error) {
        report.dbCollabsOk = true;
        report.messages.push("✅ Table 'collabs' (Marques Partenaires) : Accessible");
      } else {
        report.messages.push("❌ Table 'collabs' : " + error.message);
      }
    } catch (e) {
      report.messages.push("❌ Table 'collabs' : " + e.message);
    }

    // 4. Table contact_messages
    try {
      const { data, error } = await withTimeout(testClient.from('contact_messages').select('id').limit(1), 3500);
      if (!error) {
        report.dbMessagesOk = true;
        report.messages.push("✅ Table 'contact_messages' (Boîte Réception) : Accessible");
      } else {
        report.messages.push("❌ Table 'contact_messages' : " + error.message);
      }
    } catch (e) {
      report.messages.push("❌ Table 'contact_messages' : " + e.message);
    }

    // 5. Table site_settings
    try {
      const { data, error } = await withTimeout(testClient.from('site_settings').select('key').limit(1), 3500);
      if (!error) {
        report.dbSettingsOk = true;
        report.messages.push("✅ Table 'site_settings' (KPIs & Réglages) : Accessible");
      } else {
        report.messages.push("❌ Table 'site_settings' : " + error.message);
      }
    } catch (e) {
      report.messages.push("❌ Table 'site_settings' : " + e.message);
    }

    // 6. Bucket Storage 'media'
    try {
      const { data, error } = await withTimeout(testClient.storage.from('media').list('', { limit: 1 }), 3500);
      if (!error) {
        report.storageBucketOk = true;
        report.messages.push("✅ Bucket Storage 'media' (Vidéos & Photos) : Accessible");
      } else {
        report.messages.push("⚠️ Bucket Storage 'media' : " + error.message);
      }
    } catch (e) {
      report.messages.push("⚠️ Bucket Storage 'media' : " + e.message);
    }

    report.overallSuccess = Boolean(
      report.clientOk &&
      report.dbContentsOk &&
      report.dbGalleryOk &&
      report.dbCollabsOk
    );

    return report;
  }

  // ==================================================================
  // STORAGE : UPLOAD FICHIERS
  // ==================================================================
  async uploadFile(file, folder = 'uploads') {
    if (!file) return null;

    if (this.isConfigured()) {
      try {
        const fileExt = file.name.split('.').pop();
        const cleanExt = fileExt ? `.${fileExt}` : '';
        const fileName = `${folder}/${Date.now()}_${Math.random().toString(36).substring(2, 8)}${cleanExt}`;

        const uploadPromise = this.client.storage
          .from('media')
          .upload(fileName, file, { cacheControl: '3600', upsert: false });

        const { data, error } = await withTimeout(uploadPromise, 15000);

        if (!error && data) {
          const { data: publicUrlData } = this.client.storage
            .from('media')
            .getPublicUrl(fileName);

          if (publicUrlData && publicUrlData.publicUrl) {
            return publicUrlData.publicUrl;
          }
        }
      } catch (err) {
        console.warn("Upload Supabase Storage échoué, repli en cours :", err.message);
      }
    }

    // Repli en Base64 dataURL pour fichiers légers (< 5 Mo)
    if (file.size < 5 * 1024 * 1024) {
      return await this.fileToBase64(file);
    }
    throw new Error("Pour les fichiers de plus de 5 Mo (vidéos HD lourdes), configurez le bucket Supabase Storage ou utilisez un lien vidéo direct.");
  }

  fileToBase64(file) {
    return new Promise((resolve, reject) => {
      if (!file) { resolve(""); return; }
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  // ==================================================================
  // 1. VIDÉOS & REELS (CRUD + REORDER)
  // ==================================================================
  async getContents() {
    if (this.isConfigured()) {
      try {
        const query = this.client
          .from('contents')
          .select('*')
          .order('order_index', { ascending: true })
          .order('created_at', { ascending: false });

        const { data, error } = await withTimeout(query, 2800);

        if (!error && Array.isArray(data)) {
          const list = data.map(item => ({
            id: item.id,
            caption: item.caption || "@khadija_nd",
            category: item.category || "reels",
            video: item.video_url || "",
            order_index: item.order_index !== undefined ? item.order_index : 0,
            created_at: item.created_at
          }));
          this.setLocal(SUPABASE_STORAGE_KEYS.localContents, list);
          return list;
        }
      } catch (err) {
        console.warn("getContents Supabase fallback local :", err.message);
      }
    }
    return this.getLocal(SUPABASE_STORAGE_KEYS.localContents, INITIAL_FALLBACK_DATA.contents);
  }

  async addContent(caption, videoUrl, category = "reels") {
    const localList = this.getLocal(SUPABASE_STORAGE_KEYS.localContents, INITIAL_FALLBACK_DATA.contents);
    const newOrder = localList.length > 0 ? Math.max(...localList.map(i => i.order_index || 0)) + 1 : 1;

    const newContent = {
      caption: caption || "@khadija_nd",
      video_url: videoUrl || "",
      category: category || "reels",
      order_index: newOrder
    };

    let createdItem = {
      id: "c_" + Date.now().toString(36) + Math.random().toString(36).slice(2, 7),
      caption: newContent.caption,
      category: newContent.category,
      video: newContent.video_url,
      order_index: newContent.order_index,
      created_at: new Date().toISOString()
    };

    if (this.isConfigured()) {
      try {
        const query = this.client
          .from('contents')
          .insert([newContent])
          .select()
          .single();

        const { data, error } = await withTimeout(query, 4000);
        if (!error && data) {
          createdItem = {
            id: data.id,
            caption: data.caption,
            category: data.category || "reels",
            video: data.video_url,
            order_index: data.order_index,
            created_at: data.created_at
          };
        }
      } catch (err) {
        console.warn("Supabase addContent échoué (sauvegarde locale maintenue) :", err.message);
      }
    }

    localList.unshift(createdItem);
    this.setLocal(SUPABASE_STORAGE_KEYS.localContents, localList);
    return createdItem;
  }

  async updateContent(id, { caption, video, category, order_index }) {
    let localList = this.getLocal(SUPABASE_STORAGE_KEYS.localContents, INITIAL_FALLBACK_DATA.contents);
    const index = localList.findIndex(item => item.id === id);

    if (index !== -1) {
      if (caption !== undefined) localList[index].caption = caption;
      if (video !== undefined) localList[index].video = video;
      if (category !== undefined) localList[index].category = category;
      if (order_index !== undefined) localList[index].order_index = order_index;
      this.setLocal(SUPABASE_STORAGE_KEYS.localContents, localList);
    }

    if (this.isConfigured()) {
      try {
        const payload = {};
        if (caption !== undefined) payload.caption = caption;
        if (video !== undefined) payload.video_url = video;
        if (category !== undefined) payload.category = category;
        if (order_index !== undefined) payload.order_index = order_index;

        await withTimeout(this.client.from('contents').update(payload).eq('id', id), 4000);
      } catch (err) {
        console.warn("Supabase updateContent échoué :", err.message);
      }
    }

    return index !== -1 ? localList[index] : null;
  }

  async deleteContent(id) {
    if (this.isConfigured()) {
      try {
        await withTimeout(this.client.from('contents').delete().eq('id', id), 3500);
      } catch (err) {
        console.warn("Supabase deleteContent échoué :", err.message);
      }
    }

    let localList = this.getLocal(SUPABASE_STORAGE_KEYS.localContents, INITIAL_FALLBACK_DATA.contents);
    localList = localList.filter(item => item.id !== id);
    this.setLocal(SUPABASE_STORAGE_KEYS.localContents, localList);
    return true;
  }

  async reorderContents(orderedIds) {
    let localList = this.getLocal(SUPABASE_STORAGE_KEYS.localContents, INITIAL_FALLBACK_DATA.contents);
    const map = new Map(localList.map(i => [i.id, i]));
    const newList = [];

    orderedIds.forEach((id, idx) => {
      const item = map.get(id);
      if (item) {
        item.order_index = idx + 1;
        newList.push(item);
        if (this.isConfigured()) {
          this.client.from('contents').update({ order_index: idx + 1 }).eq('id', id).then().catch(()=>{});
        }
      }
    });

    this.setLocal(SUPABASE_STORAGE_KEYS.localContents, newList);
    return newList;
  }

  // ==================================================================
  // 2. UNIVERS & GALERIE (CRUD + REORDER)
  // ==================================================================
  async getGallery() {
    if (this.isConfigured()) {
      try {
        const query = this.client
          .from('gallery')
          .select('*')
          .order('order_index', { ascending: true })
          .order('created_at', { ascending: false });

        const { data, error } = await withTimeout(query, 2800);

        if (!error && Array.isArray(data) && data.length > 0) {
          const list = data.map(item => ({
            id: item.id,
            caption: item.caption || "Univers Khadija_Nd",
            category: item.category || "mode",
            image: item.image_url || "",
            order_index: item.order_index !== undefined ? item.order_index : 0,
            created_at: item.created_at
          }));
          this.setLocal(SUPABASE_STORAGE_KEYS.localGallery, list);
          return list;
        }
      } catch (err) {
        console.warn("getGallery Supabase fallback local :", err.message);
      }
    }
    return this.getLocal(SUPABASE_STORAGE_KEYS.localGallery, INITIAL_FALLBACK_DATA.gallery);
  }

  async addGalleryItem(caption, imageUrl, category = "mode") {
    const localList = this.getLocal(SUPABASE_STORAGE_KEYS.localGallery, INITIAL_FALLBACK_DATA.gallery);
    const newOrder = localList.length > 0 ? Math.max(...localList.map(i => i.order_index || 0)) + 1 : 1;

    const newItem = {
      caption: caption || "Univers Khadija_Nd",
      image_url: imageUrl || "",
      category: category || "mode",
      order_index: newOrder
    };

    let createdItem = {
      id: "g_" + Date.now().toString(36) + Math.random().toString(36).slice(2, 7),
      caption: newItem.caption,
      category: newItem.category,
      image: newItem.image_url,
      order_index: newItem.order_index,
      created_at: new Date().toISOString()
    };

    if (this.isConfigured()) {
      try {
        const query = this.client
          .from('gallery')
          .insert([newItem])
          .select()
          .single();

        const { data, error } = await withTimeout(query, 4000);
        if (!error && data) {
          createdItem = {
            id: data.id,
            caption: data.caption,
            category: data.category || "mode",
            image: data.image_url,
            order_index: data.order_index,
            created_at: data.created_at
          };
        }
      } catch (err) {
        console.warn("Supabase addGalleryItem échoué :", err.message);
      }
    }

    localList.unshift(createdItem);
    this.setLocal(SUPABASE_STORAGE_KEYS.localGallery, localList);
    return createdItem;
  }

  async updateGalleryItem(id, { caption, image, category, order_index }) {
    let localList = this.getLocal(SUPABASE_STORAGE_KEYS.localGallery, INITIAL_FALLBACK_DATA.gallery);
    const index = localList.findIndex(item => item.id === id);

    if (index !== -1) {
      if (caption !== undefined) localList[index].caption = caption;
      if (image !== undefined) localList[index].image = image;
      if (category !== undefined) localList[index].category = category;
      if (order_index !== undefined) localList[index].order_index = order_index;
      this.setLocal(SUPABASE_STORAGE_KEYS.localGallery, localList);
    }

    if (this.isConfigured()) {
      try {
        const payload = {};
        if (caption !== undefined) payload.caption = caption;
        if (image !== undefined) payload.image_url = image;
        if (category !== undefined) payload.category = category;
        if (order_index !== undefined) payload.order_index = order_index;

        await withTimeout(this.client.from('gallery').update(payload).eq('id', id), 4000);
      } catch (err) {
        console.warn("Supabase updateGalleryItem échoué :", err.message);
      }
    }

    return index !== -1 ? localList[index] : null;
  }

  async deleteGalleryItem(id) {
    if (this.isConfigured()) {
      try {
        await withTimeout(this.client.from('gallery').delete().eq('id', id), 3500);
      } catch (err) {
        console.warn("Supabase deleteGalleryItem échoué :", err.message);
      }
    }

    let localList = this.getLocal(SUPABASE_STORAGE_KEYS.localGallery, INITIAL_FALLBACK_DATA.gallery);
    localList = localList.filter(item => item.id !== id);
    this.setLocal(SUPABASE_STORAGE_KEYS.localGallery, localList);
    return true;
  }

  async reorderGallery(orderedIds) {
    let localList = this.getLocal(SUPABASE_STORAGE_KEYS.localGallery, INITIAL_FALLBACK_DATA.gallery);
    const map = new Map(localList.map(i => [i.id, i]));
    const newList = [];

    orderedIds.forEach((id, idx) => {
      const item = map.get(id);
      if (item) {
        item.order_index = idx + 1;
        newList.push(item);
        if (this.isConfigured()) {
          this.client.from('gallery').update({ order_index: idx + 1 }).eq('id', id).then().catch(()=>{});
        }
      }
    });

    this.setLocal(SUPABASE_STORAGE_KEYS.localGallery, newList);
    return newList;
  }

  // ==================================================================
  // 3. COLLABORATIONS DE MARQUE (CRUD + REORDER)
  // ==================================================================
  async getCollabs() {
    if (this.isConfigured()) {
      try {
        const query = this.client
          .from('collabs')
          .select('*')
          .order('order_index', { ascending: true })
          .order('created_at', { ascending: false });

        const { data, error } = await withTimeout(query, 2800);

        if (!error && Array.isArray(data) && data.length > 0) {
          const list = data.map(item => ({
            id: item.id,
            name: item.name,
            logo: item.logo_url || "",
            order_index: item.order_index !== undefined ? item.order_index : 0,
            created_at: item.created_at
          }));
          this.setLocal(SUPABASE_STORAGE_KEYS.localCollabs, list);
          return list;
        }
      } catch (err) {
        console.warn("getCollabs Supabase fallback local :", err.message);
      }
    }
    return this.getLocal(SUPABASE_STORAGE_KEYS.localCollabs, INITIAL_FALLBACK_DATA.collabs);
  }

  async addCollab(name, logoUrl) {
    const localList = this.getLocal(SUPABASE_STORAGE_KEYS.localCollabs, INITIAL_FALLBACK_DATA.collabs);
    const newOrder = localList.length > 0 ? Math.max(...localList.map(i => i.order_index || 0)) + 1 : 1;

    const newItem = {
      name: name || "Nouvelle Marque",
      logo_url: logoUrl || "",
      order_index: newOrder
    };

    let createdItem = {
      id: "b_" + Date.now().toString(36) + Math.random().toString(36).slice(2, 7),
      name: newItem.name,
      logo: newItem.logo_url,
      order_index: newItem.order_index,
      created_at: new Date().toISOString()
    };

    if (this.isConfigured()) {
      try {
        const query = this.client
          .from('collabs')
          .insert([newItem])
          .select()
          .single();

        const { data, error } = await withTimeout(query, 4000);
        if (!error && data) {
          createdItem = {
            id: data.id,
            name: data.name,
            logo: data.logo_url,
            order_index: data.order_index,
            created_at: data.created_at
          };
        }
      } catch (err) {
        console.warn("Supabase addCollab échoué :", err.message);
      }
    }

    localList.unshift(createdItem);
    this.setLocal(SUPABASE_STORAGE_KEYS.localCollabs, localList);
    return createdItem;
  }

  async updateCollab(id, { name, logo, order_index }) {
    let localList = this.getLocal(SUPABASE_STORAGE_KEYS.localCollabs, INITIAL_FALLBACK_DATA.collabs);
    const index = localList.findIndex(item => item.id === id);

    if (index !== -1) {
      if (name !== undefined) localList[index].name = name;
      if (logo !== undefined) localList[index].logo = logo;
      if (order_index !== undefined) localList[index].order_index = order_index;
      this.setLocal(SUPABASE_STORAGE_KEYS.localCollabs, localList);
    }

    if (this.isConfigured()) {
      try {
        const payload = {};
        if (name !== undefined) payload.name = name;
        if (logo !== undefined) payload.logo_url = logo;
        if (order_index !== undefined) payload.order_index = order_index;

        await withTimeout(this.client.from('collabs').update(payload).eq('id', id), 4000);
      } catch (err) {
        console.warn("Supabase updateCollab échoué :", err.message);
      }
    }

    return index !== -1 ? localList[index] : null;
  }

  async deleteCollab(id) {
    if (this.isConfigured()) {
      try {
        await withTimeout(this.client.from('collabs').delete().eq('id', id), 3500);
      } catch (err) {
        console.warn("Supabase deleteCollab échoué :", err.message);
      }
    }

    let localList = this.getLocal(SUPABASE_STORAGE_KEYS.localCollabs, INITIAL_FALLBACK_DATA.collabs);
    localList = localList.filter(item => item.id !== id);
    this.setLocal(SUPABASE_STORAGE_KEYS.localCollabs, localList);
    return true;
  }

  async reorderCollabs(orderedIds) {
    let localList = this.getLocal(SUPABASE_STORAGE_KEYS.localCollabs, INITIAL_FALLBACK_DATA.collabs);
    const map = new Map(localList.map(i => [i.id, i]));
    const newList = [];

    orderedIds.forEach((id, idx) => {
      const item = map.get(id);
      if (item) {
        item.order_index = idx + 1;
        newList.push(item);
        if (this.isConfigured()) {
          this.client.from('collabs').update({ order_index: idx + 1 }).eq('id', id).then().catch(()=>{});
        }
      }
    });

    this.setLocal(SUPABASE_STORAGE_KEYS.localCollabs, newList);
    return newList;
  }

  // ==================================================================
  // 4. MESSAGES DE CONTACT & PARTENARIATS
  // ==================================================================
  async sendContactMessage({ name, email, brand, message, projectType }) {
    const newMsg = {
      name: (name || "").trim(),
      email: (email || "").trim(),
      brand: brand ? brand.trim() : '',
      message: (message || "").trim(),
      project_type: projectType || 'Placement / Reel',
      status: 'nouveau',
      created_at: new Date().toISOString()
    };

    if (this.isConfigured()) {
      try {
        const query = this.client.from('contact_messages').insert([newMsg]);
        const { error } = await withTimeout(query, 5000);
        if (!error) {
          return { success: true, message: "Votre demande a été transmise avec succès !" };
        }
      } catch (err) {
        console.warn("Supabase sendContactMessage échoué :", err.message);
      }
    }

    const localMsgs = this.getLocal(SUPABASE_STORAGE_KEYS.localMessages, []);
    localMsgs.unshift({
      id: "m_" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
      name: newMsg.name,
      email: newMsg.email,
      brand: newMsg.brand,
      message: newMsg.message,
      projectType: newMsg.project_type,
      status: newMsg.status,
      created_at: newMsg.created_at
    });
    this.setLocal(SUPABASE_STORAGE_KEYS.localMessages, localMsgs);
    return { success: true, message: "Votre message a été bien enregistré ✦" };
  }

  async getContactMessages() {
    if (this.isConfigured()) {
      try {
        const query = this.client
          .from('contact_messages')
          .select('*')
          .order('created_at', { ascending: false });

        const { data, error } = await withTimeout(query, 2800);

        if (!error && Array.isArray(data)) {
          const list = data.map(m => ({
            id: m.id,
            name: m.name,
            email: m.email,
            brand: m.brand,
            message: m.message,
            projectType: m.project_type || 'Placement / Reel',
            status: m.status || 'nouveau',
            created_at: m.created_at
          }));
          this.setLocal(SUPABASE_STORAGE_KEYS.localMessages, list);
          return list;
        }
      } catch (err) {
        console.warn("getContactMessages Supabase fallback local :", err.message);
      }
    }
    return this.getLocal(SUPABASE_STORAGE_KEYS.localMessages, []);
  }

  async updateContactMessageStatus(id, newStatus) {
    let localMsgs = this.getLocal(SUPABASE_STORAGE_KEYS.localMessages, []);
    const msg = localMsgs.find(m => m.id === id);
    if (msg) {
      msg.status = newStatus;
      this.setLocal(SUPABASE_STORAGE_KEYS.localMessages, localMsgs);
    }

    if (this.isConfigured()) {
      try {
        await withTimeout(this.client.from('contact_messages').update({ status: newStatus }).eq('id', id), 3500);
      } catch (err) {
        console.warn("Supabase updateContactMessageStatus échoué :", err.message);
      }
    }
    return true;
  }

  async deleteContactMessage(id) {
    if (this.isConfigured()) {
      try {
        await withTimeout(this.client.from('contact_messages').delete().eq('id', id), 3500);
      } catch (err) {
        console.warn("Supabase deleteContactMessage échoué :", err.message);
      }
    }

    let localMsgs = this.getLocal(SUPABASE_STORAGE_KEYS.localMessages, []);
    localMsgs = localMsgs.filter(m => m.id !== id);
    this.setLocal(SUPABASE_STORAGE_KEYS.localMessages, localMsgs);
    return true;
  }

  // ==================================================================
  // 5. RÉGLAGES DU SITE & CHIFFRES CLÉS (KPIs)
  // ==================================================================
  async getSiteSettings() {
    const defaultSettings = { ...INITIAL_FALLBACK_DATA.settings };

    if (this.isConfigured()) {
      try {
        const query = this.client.from('site_settings').select('*');
        const { data, error } = await withTimeout(query, 2500);

        if (!error && Array.isArray(data) && data.length > 0) {
          const mapped = { ...defaultSettings };
          data.forEach(row => {
            if (row.key && row.value !== undefined) {
              mapped[row.key] = row.value;
            }
          });
          this.setLocal(SUPABASE_STORAGE_KEYS.localSettings, mapped);
          return mapped;
        }
      } catch (err) {
        console.warn("getSiteSettings Supabase fallback local :", err.message);
      }
    }

    const local = this.getLocal(SUPABASE_STORAGE_KEYS.localSettings, defaultSettings);
    return { ...defaultSettings, ...local };
  }

  async saveSiteSettings(settings) {
    const current = await this.getSiteSettings();
    const updated = { ...current, ...settings };

    this.setLocal(SUPABASE_STORAGE_KEYS.localSettings, updated);

    if (this.isConfigured()) {
      try {
        const rows = Object.keys(updated).map(k => ({
          key: k,
          value: updated[k],
          updated_at: new Date().toISOString()
        }));
        await withTimeout(this.client.from('site_settings').upsert(rows, { onConflict: 'key' }), 5000);
      } catch (err) {
        console.warn("Supabase saveSiteSettings échoué :", err.message);
      }
    }
    return updated;
  }

  // ==================================================================
  // 6. PACKS & FORMULES DE COLLABORATION (CRUD + REORDER)
  // ==================================================================
  async getPacks() {
    if (this.isConfigured()) {
      try {
        const query = this.client.from('site_settings').select('value').eq('key', 'collaboration_packs').maybeSingle();
        const { data, error } = await withTimeout(query, 2800);
        if (!error && data && Array.isArray(data.value) && data.value.length > 0) {
          this.setLocal(SUPABASE_STORAGE_KEYS.localPacks, data.value);
          return data.value;
        }
      } catch (err) {
        console.warn("getPacks Supabase fallback local :", err.message);
      }
    }
    return this.getLocal(SUPABASE_STORAGE_KEYS.localPacks, INITIAL_FALLBACK_DATA.packs);
  }

  async savePacks(packsList) {
    this.setLocal(SUPABASE_STORAGE_KEYS.localPacks, packsList);
    if (this.isConfigured()) {
      try {
        await withTimeout(this.client.from('site_settings').upsert({
          key: 'collaboration_packs',
          value: packsList,
          updated_at: new Date().toISOString()
        }, { onConflict: 'key' }), 4000);
      } catch (err) {
        console.warn("Supabase savePacks échoué :", err.message);
      }
    }
    return packsList;
  }

  async addPack({ title, tagline, popular = false, popularBadge = "", reels = 1, stories = 2, ugc = 0, ads = false, features = [], buttonText = "" }) {
    const list = await this.getPacks();
    const newOrder = list.length > 0 ? Math.max(...list.map(p => p.order_index || 0)) + 1 : 1;
    const newPack = {
      id: "p_" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
      title: title || "Nouveau Pack",
      tagline: tagline || "",
      popular: Boolean(popular),
      popularBadge: popularBadge || (popular ? "★ Le Plus Demandé" : ""),
      reels: parseInt(reels, 10) || 0,
      stories: parseInt(stories, 10) || 0,
      ugc: parseInt(ugc, 10) || 0,
      ads: Boolean(ads),
      features: Array.isArray(features) ? features : (typeof features === 'string' ? features.split('\n').map(s=>s.trim()).filter(Boolean) : []),
      buttonText: buttonText || `Sélectionner ${title || 'Pack'} ✦`,
      order_index: newOrder,
      created_at: new Date().toISOString()
    };
    list.push(newPack);
    await this.savePacks(list);
    return newPack;
  }

  async updatePack(id, updates) {
    const list = await this.getPacks();
    const idx = list.findIndex(p => p.id === id);
    if (idx !== -1) {
      if (updates.title !== undefined) list[idx].title = updates.title;
      if (updates.tagline !== undefined) list[idx].tagline = updates.tagline;
      if (updates.popular !== undefined) list[idx].popular = Boolean(updates.popular);
      if (updates.popularBadge !== undefined) list[idx].popularBadge = updates.popularBadge;
      if (updates.reels !== undefined) list[idx].reels = parseInt(updates.reels, 10) || 0;
      if (updates.stories !== undefined) list[idx].stories = parseInt(updates.stories, 10) || 0;
      if (updates.ugc !== undefined) list[idx].ugc = parseInt(updates.ugc, 10) || 0;
      if (updates.ads !== undefined) list[idx].ads = Boolean(updates.ads);
      if (updates.features !== undefined) {
        list[idx].features = Array.isArray(updates.features) ? updates.features : (typeof updates.features === 'string' ? updates.features.split('\n').map(s=>s.trim()).filter(Boolean) : []);
      }
      if (updates.buttonText !== undefined) list[idx].buttonText = updates.buttonText;
      if (updates.order_index !== undefined) list[idx].order_index = updates.order_index;
      await this.savePacks(list);
      return list[idx];
    }
    return null;
  }

  async deletePack(id) {
    let list = await this.getPacks();
    list = list.filter(p => p.id !== id);
    await this.savePacks(list);
    return true;
  }

  async reorderPacks(orderedIds) {
    let list = await this.getPacks();
    const map = new Map(list.map(p => [p.id, p]));
    const newList = [];
    orderedIds.forEach((id, idx) => {
      const item = map.get(id);
      if (item) {
        item.order_index = idx + 1;
        newList.push(item);
      }
    });
    list.forEach(p => {
      if (!orderedIds.includes(p.id)) newList.push(p);
    });
    await this.savePacks(newList);
    return newList;
  }

  // ==================================================================
  // 7. SIMULATEUR DE CAMPAGNE (CONFIG & TAUX)
  // ==================================================================
  async getSimulatorConfig() {
    const defaultCfg = { ...INITIAL_FALLBACK_DATA.simulatorConfig };
    if (this.isConfigured()) {
      try {
        const query = this.client.from('site_settings').select('value').eq('key', 'simulator_config').maybeSingle();
        const { data, error } = await withTimeout(query, 2500);
        if (!error && data && data.value && typeof data.value === 'object') {
          const merged = { ...defaultCfg, ...data.value };
          this.setLocal(SUPABASE_STORAGE_KEYS.localSimulator, merged);
          return merged;
        }
      } catch (err) {
        console.warn("getSimulatorConfig Supabase fallback local :", err.message);
      }
    }
    const local = this.getLocal(SUPABASE_STORAGE_KEYS.localSimulator, defaultCfg);
    return { ...defaultCfg, ...local };
  }

  async saveSimulatorConfig(config) {
    const current = await this.getSimulatorConfig();
    const updated = { ...current, ...config };
    this.setLocal(SUPABASE_STORAGE_KEYS.localSimulator, updated);

    if (this.isConfigured()) {
      try {
        await withTimeout(this.client.from('site_settings').upsert({
          key: 'simulator_config',
          value: updated,
          updated_at: new Date().toISOString()
        }, { onConflict: 'key' }), 4000);
      } catch (err) {
        console.warn("Supabase saveSimulatorConfig échoué :", err.message);
      }
    }
    return updated;
  }

  // ==================================================================
  // 8. EXPORT / IMPORT & SAUVEGARDE GLOBALE JSON
  // ==================================================================
  async exportAllData() {
    const contents = await this.getContents();
    const gallery = await this.getGallery();
    const collabs = await this.getCollabs();
    const packs = await this.getPacks();
    const simulatorConfig = await this.getSimulatorConfig();
    const messages = await this.getContactMessages();
    const settings = await this.getSiteSettings();

    return {
      version: "2.1",
      exportDate: new Date().toISOString(),
      contents,
      gallery,
      collabs,
      packs,
      simulatorConfig,
      messages,
      settings
    };
  }

  async importAllData(jsonData) {
    if (!jsonData || typeof jsonData !== 'object') {
      throw new Error("Format de fichier JSON invalide");
    }

    if (Array.isArray(jsonData.contents)) {
      this.setLocal(SUPABASE_STORAGE_KEYS.localContents, jsonData.contents);
    }
    if (Array.isArray(jsonData.gallery)) {
      this.setLocal(SUPABASE_STORAGE_KEYS.localGallery, jsonData.gallery);
    }
    if (Array.isArray(jsonData.collabs)) {
      this.setLocal(SUPABASE_STORAGE_KEYS.localCollabs, jsonData.collabs);
    }
    if (Array.isArray(jsonData.packs)) {
      await this.savePacks(jsonData.packs);
    }
    if (jsonData.simulatorConfig && typeof jsonData.simulatorConfig === 'object') {
      await this.saveSimulatorConfig(jsonData.simulatorConfig);
    }
    if (Array.isArray(jsonData.messages)) {
      this.setLocal(SUPABASE_STORAGE_KEYS.localMessages, jsonData.messages);
    }
    if (jsonData.settings && typeof jsonData.settings === 'object') {
      await this.saveSiteSettings(jsonData.settings);
    }

    return true;
  }
}

// Instance singleton
window.supabaseService = new SupabaseService();
